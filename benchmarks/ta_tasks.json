{
  "schema_version": 3,
  "benchmark_name": "ta_agent_integrated_benchmark_v3",
  "description": "TA Agent 统一评测集：每道题同时评测功能层结果和 Agent 机制层过程。功能层决定任务是否通过，Agent 机制层用于计算综合分和分析系统工程能力。",
  "metric_groups": {
    "functional_layer": [
      "intent_accuracy",
      "functional_pass_rate",
      "functional_average_score",
      "section_completion_rate",
      "fact_coverage_rate",
      "rule_decision_accuracy"
    ],
    "agent_mechanism_layer": [
      "agent_average_score",
      "skill_call_accuracy",
      "tool_call_coverage",
      "memory_state_correctness",
      "trace_completeness",
      "step_budget_rate"
    ]
  },
  "task_distribution": {
    "日报与周报生成": 3,
    "项目计划拆解": 1,
    "项目进度查询": 2,
    "导师同步判断": 2,
    "产物质量识别": 2
  },
  "default_scoring": {
    "functional_weight": 0.7,
    "agent_weight": 0.3,
    "pass_rule": "functional_pass_required"
  },
  "tasks": [
    {
      "id": "ta_daily_baseline_progress",
      "category": "daily_report",
      "prompt": "我今天完成了 PageIndex baseline 复现，记录了 latency、token 和 LLM calls，产物保存在 baseline_results.md，明天准备开始调研 GBrain 和 Cognee，帮我写日报。",
      "fixture_case": "samples/case_baseline",
      "expected_intent": "write_daily_report",
      "covered_functions": [
        "日报生成",
        "证据保留",
        "次日计划"
      ],
      "expected_artifact": "生成包含今日进展、阻塞、证据和次日计划的规范日报，并保留用户提供的实验指标与文件名。",
      "functional_criteria": {
        "required_sections": [
          "今日进展",
          "阻塞",
          "证据",
          "次日计划"
        ],
        "must_include_keywords": [
          "PageIndex",
          "baseline",
          "latency",
          "token",
          "LLM calls",
          "baseline_results.md",
          "GBrain",
          "Cognee"
        ],
        "mentor_sync_required": false
      },
      "agent_criteria": {
        "expected_skill": "daily_report_skill",
        "required_tools": [
          "read_project_state",
          "draft_daily_report",
          "check_evidence_coverage"
        ],
        "memory_read_required": false,
        "memory_write_required": true,
        "state_update_required": true,
        "trace_required": true,
        "max_steps": 6
      },
      "scoring": {
        "functional_weight": 0.7,
        "agent_weight": 0.3,
        "pass_rule": "functional_pass_required"
      }
    },
    {
      "id": "ta_weekly_baseline_summary",
      "category": "weekly_report",
      "prompt": "这周完成了 PageIndex 单文档和多文档 baseline 复现，整理了 latency、token、LLM calls 和 tree depth 指标，结果记录在 baseline_comparison.md。下周准备完成图谱抽取工具选型，帮我结合当前项目状态写周报。",
      "fixture_case": "samples/case_baseline",
      "expected_intent": "write_weekly_report",
      "covered_functions": [
        "周报生成",
        "证据保留",
        "里程碑关联",
        "下周计划"
      ],
      "expected_artifact": "生成包含本周完成、证据、阻塞与风险、里程碑和下周计划的规范周报。",
      "functional_criteria": {
        "required_sections": [
          "本周完成",
          "证据",
          "阻塞与风险",
          "里程碑",
          "下周计划"
        ],
        "must_include_keywords": [
          "PageIndex",
          "单文档",
          "多文档",
          "latency",
          "token",
          "LLM calls",
          "tree depth",
          "baseline_comparison.md",
          "图谱抽取工具选型"
        ],
        "mentor_sync_required": false
      },
      "agent_criteria": {
        "expected_skill": "weekly_report_skill",
        "required_tools": [
          "read_project_state",
          "read_daily_history",
          "evaluate_milestone_completion",
          "draft_weekly_report"
        ],
        "memory_read_required": true,
        "memory_write_required": true,
        "state_update_required": true,
        "trace_required": true,
        "max_steps": 8
      },
      "scoring": {
        "functional_weight": 0.7,
        "agent_weight": 0.3,
        "pass_rule": "functional_pass_required"
      }
    },
    {
      "id": "ta_weekly_mixed_delay_quality_mentor",
      "category": "weekly_report_mixed",
      "prompt": "这周 W3 的 G-T Pointer 映射没有按计划完成，连续两天卡在跨文档共现实体的节点合并策略，目前只有设计说明，没有单元测试和实验结果。请帮我生成周报，指出产物质量问题，判断是否需要和导师同步，并给出下周计划。",
      "fixture_case": "samples/case_mapping_delay",
      "expected_intent": "write_weekly_report",
      "covered_functions": [
        "周报生成",
        "延期识别",
        "阻塞识别",
        "产物质量识别",
        "导师同步判断",
        "下周计划"
      ],
      "expected_artifact": "生成规范周报，识别 W3 延期、测试和实验缺口，并建议就节点合并策略与导师同步。",
      "functional_criteria": {
        "required_sections": [
          "本周完成",
          "证据",
          "阻塞与风险",
          "里程碑",
          "下周计划"
        ],
        "must_include_keywords": [
          "W3",
          "G-T Pointer",
          "跨文档共现实体",
          "节点合并策略",
          "单元测试",
          "实验结果",
          "导师"
        ],
        "blocker_detected": true,
        "quality_gap_detected": true,
        "schedule_delay_detected": true,
        "mentor_sync_required": true
      },
      "agent_criteria": {
        "expected_skill": "weekly_report_skill",
        "required_tools": [
          "read_project_state",
          "evaluate_milestone_completion",
          "check_artifact_quality",
          "mentor_sync_check",
          "draft_weekly_report"
        ],
        "memory_read_required": true,
        "memory_write_required": true,
        "state_update_required": true,
        "trace_required": true,
        "max_steps": 10
      },
      "scoring": {
        "functional_weight": 0.7,
        "agent_weight": 0.3,
        "pass_rule": "functional_pass_required"
      }
    },
    {
      "id": "ta_project_plan_decomposition_8_weeks",
      "category": "project_plan_decomposition",
      "prompt": "请根据项目目标“面向金融文档撰写 Agent 的非向量化知识库构建与可追溯检索能力升级”，帮我拆成 8 周计划。每周需要包含目标、主要任务、重难点和可验收产物。",
      "fixture_case": "samples/project_plan.json",
      "expected_intent": "decompose_plan",
      "covered_functions": [
        "项目目标理解",
        "八周计划拆解",
        "里程碑规划",
        "重难点识别",
        "验收标准生成"
      ],
      "expected_artifact": "生成完整的 8 周项目计划，每周包含目标、任务、重难点和可验收产物。",
      "functional_criteria": {
        "required_weeks": 8,
        "required_fields_per_week": [
          "目标",
          "任务",
          "可验收产物"
        ],
        "must_include_keywords": [
          "PageIndex",
          "图谱",
          "G-T Pointer",
          "树剪枝",
          "实验",
          "报告"
        ]
      },
      "agent_criteria": {
        "expected_skill": "project_planning_skill",
        "required_tools": [
          "read_project_document",
          "decompose_milestones",
          "generate_acceptance_criteria",
          "write_project_state"
        ],
        "memory_read_required": false,
        "memory_write_required": true,
        "state_update_required": true,
        "trace_required": true,
        "max_steps": 10
      },
      "scoring": {
        "functional_weight": 0.7,
        "agent_weight": 0.3,
        "pass_rule": "functional_pass_required"
      }
    },
    {
      "id": "ta_query_progress_normal",
      "category": "project_progress_query",
      "prompt": "请读取当前项目状态，告诉我项目总体完成百分之多少，并分别说明已经完成、正在进行和还没有完成的里程碑。",
      "fixture_case": "samples/case_baseline",
      "expected_intent": "query_progress",
      "covered_functions": [
        "项目状态读取",
        "加权进度计算",
        "里程碑状态展示"
      ],
      "expected_artifact": "根据里程碑权重和进度计算总体完成度，并列出已完成、进行中和未完成任务。",
      "functional_criteria": {
        "expected_completion": 0.08,
        "completion_tolerance": 0.001,
        "must_include_keywords": [
          "总体完成度",
          "W1",
          "W2",
          "进行中",
          "未完成"
        ],
        "must_use_project_state": true
      },
      "agent_criteria": {
        "expected_skill": "progress_query_skill",
        "required_tools": [
          "read_project_state",
          "compute_milestone_completion",
          "render_progress_summary"
        ],
        "memory_read_required": true,
        "memory_write_required": false,
        "state_update_required": false,
        "trace_required": true,
        "max_steps": 5
      },
      "scoring": {
        "functional_weight": 0.7,
        "agent_weight": 0.3,
        "pass_rule": "functional_pass_required"
      }
    },
    {
      "id": "ta_query_progress_with_delay",
      "category": "project_progress_delay",
      "prompt": "W3 已经到期但还没有完成。请结合当前项目状态计算实际完成度，和预期进度比较，并告诉我延期的是哪个里程碑以及接下来应该优先完成什么。",
      "fixture_case": "samples/case_mapping_delay",
      "expected_intent": "query_progress",
      "covered_functions": [
        "项目状态读取",
        "加权进度计算",
        "预期进度对比",
        "延期里程碑识别"
      ],
      "expected_artifact": "输出实际完成度和预期进度，识别 W3 已到期未完成，并给出优先任务。",
      "functional_criteria": {
        "expected_completion": 0.26,
        "expected_project_completion": 0.35,
        "completion_tolerance": 0.001,
        "must_include_keywords": [
          "总体完成度",
          "W3",
          "G-T Pointer",
          "进行中",
          "未完成"
        ],
        "must_use_project_state": true,
        "schedule_delay_detected": true
      },
      "agent_criteria": {
        "expected_skill": "progress_query_skill",
        "required_tools": [
          "read_project_state",
          "compute_milestone_completion",
          "compare_expected_progress",
          "detect_schedule_delay"
        ],
        "memory_read_required": true,
        "memory_write_required": true,
        "state_update_required": false,
        "trace_required": true,
        "max_steps": 7
      },
      "scoring": {
        "functional_weight": 0.7,
        "agent_weight": 0.3,
        "pass_rule": "functional_pass_required"
      }
    },
    {
      "id": "ta_mentor_sync_required",
      "category": "mentor_sync_required",
      "prompt": "我连续两天都卡在金融文档实体抽取粒度标准，而且已经超过两天没有和导师同步了。请结合项目状态判断我现在是否应该找导师讨论，并说明需要和导师确认什么。",
      "fixture_case": "samples/case_graph_blocked",
      "expected_intent": "query_mentor_sync",
      "covered_functions": [
        "连续阻塞识别",
        "导师同步周期检查",
        "导师同步建议"
      ],
      "expected_artifact": "判断当前需要导师同步，并给出触发原因以及建议讨论的实体粒度标准问题。",
      "functional_criteria": {
        "must_include_keywords": [
          "导师",
          "同步",
          "阻塞",
          "超过 2 天",
          "建议"
        ],
        "mentor_sync_required": true
      },
      "agent_criteria": {
        "expected_skill": "mentor_sync_skill",
        "required_tools": [
          "read_project_state",
          "read_recent_blockers",
          "mentor_sync_check",
          "render_mentor_suggestion"
        ],
        "memory_read_required": true,
        "memory_write_required": true,
        "state_update_required": true,
        "trace_required": true,
        "max_steps": 7
      },
      "scoring": {
        "functional_weight": 0.7,
        "agent_weight": 0.3,
        "pass_rule": "functional_pass_required"
      }
    },
    {
      "id": "ta_mentor_sync_not_required",
      "category": "mentor_sync_not_required",
      "prompt": "当前任务没有明确阻塞，W1 按计划推进，而且昨天刚和导师同步过。请结合项目状态判断今天是否还需要额外联系导师。",
