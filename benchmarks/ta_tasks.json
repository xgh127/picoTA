        "must_include_keywords": [
          "导师",
          "当前不需要额外同步",
          "正常节奏"
        ],
        "mentor_sync_required": false
      },
      "agent_criteria": {
        "expected_skill": "mentor_sync_skill",
        "required_tools": [
          "read_project_state",
          "mentor_sync_check",
          "render_mentor_suggestion"
        ],
        "memory_read_required": true,
        "memory_write_required": false,
        "state_update_required": false,
        "trace_required": true,
        "max_steps": 5
      },
      "scoring": {
        "functional_weight": 0.7,
        "agent_weight": 0.3,
        "pass_rule": "functional_pass_required"
      }
    },
    {
      "id": "ta_quality_missing_evidence",
      "category": "artifact_quality_review",
      "prompt": "请检查下面这段工作记录的产物质量：今天继续推进图谱抽取，整体进展正常。除此之外没有提供文件、截图、实验结果、提交记录或任务状态。",
      "fixture_case": "samples/case_graph_blocked",
      "expected_intent": "review_artifact_quality",
      "covered_functions": [
