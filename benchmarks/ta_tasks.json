        "证据缺口识别",
        "禁止虚构证据",
        "补充材料建议"
      ],
      "expected_artifact": "指出工作描述缺少可验证证据，并建议补充文件、截图、实验结果、提交记录或任务状态。",
      "functional_criteria": {
        "must_include_keywords": [
          "证据",
          "文件",
          "截图",
          "实验结果",
          "提交记录",
          "任务状态"
        ],
        "evidence_gap_detected": true
      },
      "agent_criteria": {
        "expected_skill": "artifact_quality_skill",
