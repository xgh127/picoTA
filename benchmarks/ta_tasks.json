        "memory_read_required": false,
        "memory_write_required": true,
        "state_update_required": false,
        "trace_required": true,
        "max_steps": 5
      },
      "scoring": {
        "functional_weight": 0.7,
        "agent_weight": 0.3,
        "pass_rule": "functional_pass_required"
      }
    },
    {
      "id": "ta_quality_missing_tests_and_acceptance",
      "category": "artifact_quality_review",
      "prompt": "请检查这项产物是否真的可以算完成：G-T Pointer 映射模块已经写完，目前只有代码文件，没有单元测试、跨文档边界 case、实验结果和验收记录。",
      "fixture_case": "samples/case_mapping_delay",
